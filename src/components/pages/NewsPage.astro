---
/** Новости и статьи клуба – шаблон в новом стиле (лента Тильды пока не перенесена, см. src/data/blog.ts).
    У каждого клуба своя страница: /news (Империал), /news_abricosovo, /news_admiral. */
import Site from '../../layouts/Site.astro';
import { posts } from '../../data/blog';
import { clubs, type ClubId } from '../../data/clubs';
import '../../styles/blog.css';

const { club: id, path } = Astro.props as { club: ClubId; path: string };
const c = clubs[id];
const [top, ...rest] = posts.filter((p) => p.clubs.includes(id));
---
<Site title={`Новости и статьи – ${c.name}`} description={`Новости и статьи фитнес-клуба ${c.name}.`} club={id} path={path} crumbs={[{ text: c.name, href: c.home }, { text: 'Новости и статьи', href: '' }]}>
  <section class="bla-wrap bla-sec--sm">
    <h1 class="bla-h1" style="color:var(--green)">Новости и статьи</h1>
    <p class="bla-lead" style="margin-top:14px">Новости {c.name}, статьи о тренировках, бассейне и заботе о себе</p>
    <span class="bla-note-tpl">Шаблон страницы – карточки с пометкой «пример» заменятся лентой новостей</span>
    <a class="bla-card bla-post bla-post--top" href={top.href}>
      <div class="bla-cover bla-post__img" data-bg={top.img}></div>
      <div class="bla-post__body">
        <div class="bla-post__meta"><span>{top.tag}</span>{top.read && <span>{top.read}</span>}{top.demo && <span class="is-demo">пример</span>}</div>
        <h3>{top.title}</h3>
        <p>{top.lead}</p>
        <span class="bla-post__more">Читать статью →</span>
      </div>
    </a>
    <div class="bla-posts">
      {rest.map((p) => (
        <a class="bla-card bla-post" href={p.href}>
          <div class="bla-cover bla-post__img" data-bg={p.img}></div>
          <div class="bla-post__body">
            <div class="bla-post__meta"><span>{p.tag}</span>{p.demo && <span class="is-demo">пример</span>}</div>
            <h3>{p.title}</h3>
            <p>{p.lead}</p>
            <span class="bla-post__more">Читать →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Site>

