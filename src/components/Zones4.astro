---
/** Фитнес-зоны для /imperial4 – большой слайдер (выбран владельцем 28.10 из вкладок, ленты и плиток): одна зона на весь
    блок – фото и графитовая плашка с текстом, стрелки, ниже миниатюры всех зон; на телефоне – свайп.
    Стили – src/styles/zones4.css, поведение – src/scripts/imperial4.ts. */
import { zones } from '../data/imperial';
import '../styles/zones4.css';

const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="y-sec" id="zones" data-zones4>
  <div class="y-head">
    <h2 class="y-h2">Фитнес-зоны</h2>
    <p class="y-lead">Листайте стрелками или выберите зону ниже</p>
  </div>

  <div class="zv zv-d">
    <div class="zv-d__stage y-plate">
      {zones.map((z, i) => (
        <article class:list={['zv-d__slide', { 'is-on': i === 0 }]} data-slide4={String(i)} aria-hidden={i === 0 ? 'false' : 'true'}>
          <div class="zv-d__photo"><img src={z.img} alt={z.title} loading="lazy" /></div>
          <div class="zv-d__card">
            <span class="zv-d__k">{pad(i)} / {pad(zones.length - 1)}</span>
            <h3 class="y-h3">{z.title}</h3>
            <div class="bb-text"><Fragment set:html={z.html} /></div>
          </div>
        </article>
      ))}
      <div class="zv-d__nav">
        <button type="button" data-slide-go="-1" aria-label="Предыдущая зона">←</button>
        <button type="button" data-slide-go="1" aria-label="Следующая зона">→</button>
      </div>
    </div>
    <div class="zv-d__thumbs">
      {zones.map((z, i) => (
        <button type="button" class:list={['zv-d__thumb', { 'is-on': i === 0 }]} data-thumb4={String(i)}>
          <img src={z.img} alt="" loading="lazy" />
          <span>{z.tab}</span>
        </button>
      ))}
    </div>
  </div>
</section>
