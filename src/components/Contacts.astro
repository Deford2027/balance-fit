---
/** Контакты клуба: карточка и Яндекс.Карта. */
import { clubs, icons, type ClubId } from '../data/clubs';
import ClubMap from './ClubMap.astro';
const { club: id, title = 'Контакты', h = 'h2', social = false } = Astro.props as { club: ClubId; title?: string; h?: 'h1' | 'h2'; social?: boolean };
const c = clubs[id];
const H = h;
---
<section class="bla-wrap bla-sec" id="contacts">
  <H class:list={[h === 'h1' ? 'bla-h1' : 'bla-h2']} style={h === 'h1' ? 'margin-top:12px;color:var(--green)' : undefined}>{title}</H>
  <div class="bla-contacts">
    <div class="bla-card bla-club">
      <h3>{c.name}</h3>
      <p>Свяжитесь с нами удобным способом: звоните, пишите, приезжайте</p>
      <div class="bla-club__info">
        <div>{c.contacts.hours.map(([d, t]) => <span>{d}:<br />{t}</span>)}</div>
        <div>
          <a href={c.contacts.phone.href}>{c.contacts.phone.text}</a>
          <a href={c.contacts.email.href}>{c.contacts.email.text}</a>
          <span>{c.contacts.address}</span>
        </div>
      </div>
      {social && (
        <div class="bla-soc">
          <a href={c.social.vk} target="_blank" rel="noopener"><img src={icons.vk} alt="VK" /></a>
          <a href={c.social.max} target="_blank" rel="noopener"><img src={icons.max} alt="MAX" /></a>
          <a href={c.social.tg} target="_blank" rel="noopener"><img src={icons.tg} alt="Telegram" /></a>
          <a href={c.social.wa} target="_blank" rel="noopener"><img src={icons.wa} alt="WhatsApp" /></a>
        </div>
      )}
    </div>
    <ClubMap club={id} />
  </div>
</section>
