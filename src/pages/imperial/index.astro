---
/** Главная Balance Империал в новом дизайне. Тексты, фото и ссылки – со страницы Тильды (/old/imperial). */
import Site from '../../layouts/Site.astro';
import Adv from '../../components/Adv.astro';
import Zones from '../../components/Zones.astro';
import CardsGrid from '../../components/CardsGrid.astro';
import Guest from '../../components/Guest.astro';
import Contacts from '../../components/Contacts.astro';
import BrandFooter from '../../components/BrandFooter.astro';
import { adv, zones, cards } from '../../data/imperial';
---
<Site
  title="Фитнес-клуб Balance Империал на ул.Бородинской в Краснодаре"
  description="Balance Империал оборудован передовым оборудованием для кардио- и силовых тренировок, а также проводит разнообразные групповые занятия под руководством опытных инструкторов. Присоединяйтесь к нам и начните свой путь к здоровью и фитнесу вместе с Balance!"
  club="imperial"
  path="imperial"
  theme="wh"
>
  <section class="bla-wrap">
    <div class="bla-hero">
      <div class="bla-hero__text">
        <p class="bla-eyebrow">Краснодар · ул. Бородинская 137, корп 2</p>
        <h1 class="bla-h1">Фитнес с бассейном<br />год за 39 000 ₽</h1>
        <p class="bla-meta"><span>Пн–пт 6:00–23:00</span><span>Сб–вс 7:00–23:00</span><span>ул. Бородинская 137, корп 2</span></p>
        <div class="bla-hero__btns">
          <a class="bla-btn bla-btn--red" href="#popup:myform-abr">Хочу в Balance</a>
          <a class="bla-btn bla-btn--ghost" href="#cards">Клубные карты</a>
        </div>
        <p class="bla-note">*В рамках акции вы получаете: 9 месяцев фитнеса + 3 месяца заморозки</p>
      </div>
      <div class="bla-hero__media">
        <div class="bla-cover bla-hero__img" style="background-image:url('/_t/static/tild3235-3166-4461-a636-303130303434/640480_Balance___39_.jpg')"></div>
        <div class="bla-badge"><b>39 000 ₽</b><span>год фитнеса с бассейном:<br />9 месяцев + 3 месяца заморозки</span></div>
      </div>
    </div>
  </section>

  <section class="bla-wrap bla-sec">
    <div class="bla-free">
      <div class="bla-cover bla-free__img" data-bg="/_t/static/tild3730-3535-4137-a366-396631303033/image.png"></div>
      <div class="bla-card bla-free__text">
        <h2>Свобода заниматься собой</h2>
        <p>Премиальный семейный фитнес-клуб Balance</p>
        <p>Здесь вы найдёте современные фитнес‑зоны и продуманные программы для любого уровня подготовки.</p>
        <p>Присоединяйтесь — найдите свой баланс и начните путь к лучшей версии себя уже сегодня!</p>
      </div>
    </div>
  </section>

  <Adv items={adv} />
  <Zones zones={zones} />
  <CardsGrid cards={cards} order={{ text: 'Оформить карту', href: '#popup:myform' }} />
  <Guest />
  <Contacts club="imperial" />
  <BrandFooter slot="footer" club="imperial" logo="/brand/balance-logo.svg" flat />
</Site>
