---
/** Детский клуб Balance Империал. Тексты и ссылки – со страницы Тильды (/old/imperial/kids). */
import KidsPage from '../../components/pages/KidsPage.astro';
const S = '/_t/static/';
---
<KidsPage
  club="imperial"
  path="imperial/kids"
  title="Детский фитнес-клуб Balance в Краснодаре"
  description="Большой выбор развивающих, творческих, спортивных и оздоровительных программ. Занятия в бассейне для детей от 3х месяцев."
  lead="Научим ребенка плавать, адаптируем его к детскому саду, поможем с выполнением и разбором школьных программ, а еще, у нас много разнообразных спортивных занятий (от танцев до батутов и единоборств), увлекательных мастер-классов (кулинария, живопись, химические эксперименты и тд.)!<br><br>А также, наполним интересными событиями каникульные дни, и поможем ярко и незабываемо отметить День Рождения!"
