const S = '/_t/static/';
const swim = '<p>Школа плавания — вид секций, разделенный на возрастные группы: 3-5 лет, 6-8 лет, 9-11 лет, 12-14 лет.<br>На этом уроке осваиваются спортивные виды плавания.</p><p>Регулярное посещение группы развивает общую выносливость организма, закаляет иммунитет, совершенствует координацию, прививает дисциплину и самостоятельность.</p>';
---
<KidsPage
