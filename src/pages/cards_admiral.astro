---
/** Клубные карты Balance Адмирал. Тексты и ссылки – со страницы Тильды (/old/cards_admiral). */
import CardsPage from '../components/pages/CardsPage.astro';
const S = '/_t/static/';
---
<CardsPage
  club="admiral"
  path="cards_admiral"
  title="Годовой абонемент в фитнес клуб Balance Адмирал в Туапсе"
  description="Выберите свою идеальную клубную карту. У нас вы найдете: бассейн, залы для групповых тренировок и занятий боевыми искусствами, тренажерный зал со всем необходимым оборудованием и другое."
  order="#popup:myform-adm"
  freeze="#popup:card-freeze-form-adm"
  trainer="#popup:personal-training-adm"
  cards={[
    { title: 'Balance', img: S + 'tild3365-6164-4532-b961-333963643066/photo.jpg', more: '#popup:card-1-adm', text: '<p>Безлимитная карта на 12 месяцев.<br>Свобода выбора: любое направление и в любой день.</p><p>Посещение с 7:00 до 23:00 в будни и с 8:00 до 23:00 в выходные.</p>' },
    { title: 'Дневная карта', img: S + 'tild3533-3064-4135-b933-633535303138/photo.jpg', more: '#popup:card-2-adm', text: '<p>Дневная карта на 12 месяцев<br>Вам доступны все зоны, залы и занятия попадающие в слот времени до 16:00. По очень привлекательной стоимости</p><p>Посещение с 7:00 до 16:00 в будни и с 8:00 до 23:00 в выходные.</p>' },
    { title: 'Корпоративный Balance', img: S + 'tild3836-3331-4564-b262-346235653933/photo.jpg', more: '#popup:card-3-adm', text: '<p>Безлимитные карты на 12 месяцев для вас и ваших коллег по выгодной цене.</p><p>Посещение с 7:00 до 23:00 в будни и с 8:00 до 23:00 в выходные.</p>' },
    { title: 'Balance дети', img: S + 'tild3366-3632-4439-a436-643238383334/photo.jpg', more: '#popup:card-4-adm', text: '<p>Безлимитная карта на 12 месяцев.<br>Спорт / творчество / образование / развлечения.</p><p>Посещение с 9:00 до 21:00 в будни и с 9:00 до 21:00 в выходные.</p>' },
  ]}
/>
