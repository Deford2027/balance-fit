---
/** Главная Balance Империал – премиальная версия по брендбуку: чёрный и графит, белая типографика, поля 60 px,
    цвета бренда – точечно (клубные карты, преимущества при наведении, фитнес-зоны), «искра» – в линейках секций.
    Фоновое видео, параллакс и анимация при прокрутке – src/scripts/imperial3.ts, стили – src/styles/brand3.css
    поверх brand.css. Тексты, фото, карта и форма – как на /imperial (src/data/imperial.ts). */
import Site from '../layouts/Site.astro';
import ClubMap from '../components/ClubMap.astro';
import BrandFooter from '../components/BrandFooter.astro';
import { adv, zones, cards } from '../data/imperial';
import { advIcon } from '../data/adv-icons';
import { clubs, icons } from '../data/clubs';
import { sparkPath } from '../lib/spark';
import '../styles/brand.css';
import '../styles/brand3.css';

const c = clubs.imperial;
const V = '/video/imperial3/';
const S = '/_t/static/';
/* Фон первого экрана – бесплатные ролики Pexels (лицензия Pexels разрешает коммерческое использование), пока ссылкой
   на их сайт. Лучше скачать в public/video/imperial3/, а ещё лучше – заменить съёмкой клуба. */
const heroVideo = {
  desktop: 'https://videos.pexels.com/video-files/33515057/14253888_1920_1080_25fps.mp4', // JULLIAN PRODUCTION, 1920×1080
  mobile: 'https://videos.pexels.com/video-files/30254415/12970117_1080_1920_50fps.mp4', // Azhaan Bashmil, 1080×1920
};
const advTone = ['red', 'blue', 'fresh', 'pink', 'green', 'red', 'deep', 'blue'];
const cardTone = ['red', 'blue', 'fresh', 'deep'];
const stats = [
  { n: 25, unit: ' м', text: 'взрослый бассейн на 4 дорожки' },
  { n: 32, pre: '+', unit: ' °C', text: 'вода в детском бассейне – можно с трёх месяцев' },
  { n: 50, unit: '+', text: 'программ групповых тренировок' },
  { n: 99, unit: '%', text: 'точность анализа состава тела InBody' },
];
/* Линейка секции по брендбуку: номер, «искра» и пунктир */
const rule = (n: number) => `<div class="x-rule" data-rv><span>${String(n).padStart(2, '0')}</span><svg viewBox="0 0 1000 1012" aria-hidden="true">${sparkPath}</svg><i></i></div>`;
const run = ['Бассейн 25 м', 'Life Fitness', 'Hammer Strength', 'Более 50 программ', 'InBody', 'Детский клуб', 'Balance спа', 'Balance кафе'];
---
<Site
  title="Фитнес-клуб Balance Империал на ул.Бородинской в Краснодаре"
  description="Balance Империал оборудован передовым оборудованием для кардио- и силовых тренировок, а также проводит разнообразные групповые занятия под руководством опытных инструкторов. Присоединяйтесь к нам и начните свой путь к здоровью и фитнесу вместе с Balance!"
  club="imperial"
  path="imperial"
  theme="bb bb3"
>
  <section class="x-hero" data-hero>
    <div class="x-hero__media">
      <video class="x-video" poster={V + 'hero.jpg'} autoplay muted loop playsinline preload="auto" aria-hidden="true">
        <source src={heroVideo.mobile} type="video/mp4" media="(max-width: 860px) and (orientation: portrait)" />
        <source src={heroVideo.desktop} type="video/mp4" />
      </video>
    </div>
    <div class="x-hero__in">
      <p class="x-eyebrow" data-rv>Краснодар · ул. Бородинская 137, корп 2</p>
      <h1 class="x-h1" data-split>Фитнес с&nbsp;бассейном год за&nbsp;39&nbsp;000&nbsp;₽</h1>
      <p class="x-hero__note" data-rv>*В рамках акции вы получаете: 9 месяцев фитнеса + 3 месяца заморозки</p>
      <div class="bb-btns" data-rv>
        <a class="bb-btn" href="#popup:myform-abr">Хочу в Balance</a>
        <a class="bb-btn bb-btn--line" href="#cards">Клубные карты</a>
      </div>
    </div>
  </section>

  <div class="x-run" aria-hidden="true">
    <div class="x-run__track">
      {[0, 1].map(() => (
        <div class="x-run__set">
          {run.map((t, i) => (
            <>
              <span class:list={[{ 'x-run__o': i % 2 }]}>{t}</span>
              <svg class="x-run__spark" viewBox="0 0 1000 1012"><path d="M503.352 1012C503.352 737.041 725.028 506.002 998.666 505.284H1000V498.543H998.666C725.028 497.829 503.352 274.96 503.352 0H496.545C496.545 275.369 274.254 498.543 0 498.543V505.284H496.545V1012H503.352Z" /></svg>
            </>
          ))}
        </div>
      ))}
    </div>
  </div>

  <section class="x-sec x-free" id="free">
    <div class="bb-m bb-photo x-free__media" data-rv="up">
      <img src={S + 'tild3730-3535-4137-a366-396631303033/image.png'} alt="Тренировка в Balance Империал" loading="lazy" data-parallax />
    </div>
    <div class="x-free__text">
      <Fragment set:html={rule(1)} />
      <h2 class="x-h2" data-split>Свобода заниматься собой</h2>
      <p class="bb-lead" data-rv>Премиальный семейный фитнес-клуб Balance</p>
      <p class="x-free__big" data-words>Здесь вы найдёте современные фитнес‑зоны и продуманные программы для любого уровня подготовки. Присоединяйтесь — найдите свой баланс и начните путь к лучшей версии себя уже сегодня!</p>
    </div>
  </section>

  <section class="x-sec">
    <div class="x-stats">
      {stats.map((s) => (
        <div class="x-stat" data-rv>
          <b><span>{s.pre}</span><span data-count={String(s.n)}>{s.n}</span><span>{s.unit}</span></b>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="x-sec">
    <div class="x-head">
      <Fragment set:html={rule(2)} />
      <h2 class="x-h2" data-split>Преимущества</h2>
    </div>
    <ol class="x-adv">
      {adv.map((it, i) => (
        <li class="x-adv__item" style={`--tone:var(--${advTone[i]})`} data-rv>
          <span class="x-adv__n">{String(i + 1).padStart(2, '0')}</span>
          <span class="bb-ico" set:html={advIcon(it.text)} />
          <p set:html={it.text} />
          <img class="x-adv__img" src={it.img} alt="" loading="lazy" />
        </li>
      ))}
    </ol>
  </section>

  <section class="x-sec x-zones" id="zones" data-zones>
    <div class="x-zones__stick">
      <div class="x-head">
        <Fragment set:html={rule(3)} />
        <div class="x-zones__head">
          <h2 class="x-h2" data-split>Фитнес-зоны</h2>
          <div class="x-zones__bar" aria-hidden="true"><i></i></div>
          <p class="x-zones__count" aria-hidden="true"><b data-zone-n>01</b> / {String(zones.length).padStart(2, '0')}</p>
        </div>
      </div>
      <div class="x-zones__track" data-zones-track>
        {zones.map((z, i) => (
          <article class="x-zone">
            <div class="x-zone__photo"><img src={z.img} alt={z.title} loading="lazy" /></div>
            <div class="x-zone__text">
              <span class="x-zone__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="bb-h3">{z.title}</h3>
              <div class="bb-text"><Fragment set:html={z.html} /></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="x-sec" id="cards">
    <div class="x-head x-head--row">
      <div>
        <Fragment set:html={rule(4)} />
        <h2 class="x-h2" data-split>Клубные карты</h2>
        <p class="bb-lead" data-rv>Выбирайте свою клубную карту</p>
      </div>
      <a class="bb-btn" href="#popup:myform" data-rv>Оформить карту</a>
    </div>
    <div class="x-cards">
      {cards.map((k, i) => (
        <article class="x-card" data-rv>
          <div class:list={['x-card__plate', 'bb-' + cardTone[i]]} data-tilt>
            <img class="x-card__logo" src={icons.logo} alt="" />
            <svg class="x-card__spark" viewBox="0 0 1000 1012" aria-hidden="true" set:html={sparkPath} />
            <span class="x-card__name">{k.title}</span>
          </div>
          <p class="x-card__text" set:html={k.text} />
          <p class="bb-small">{k.hours}</p>
          <a class="bb-more" href={k.more}>Подробнее</a>
        </article>
      ))}
    </div>
  </section>

  <section class="x-sec x-split" id="guest">
    <div class="bb-m bb-photo x-split__media" data-rv="up">
      <img src={S + 'tild6538-3832-4135-b161-336563656363/image.png'} alt="Аэройога в Balance Империал" loading="lazy" data-parallax />
    </div>
    <div class="x-panel" data-rv>
      <Fragment set:html={rule(5)} />
      <h2 class="x-h2">Запишитесь на&nbsp;гостевой визит</h2>
      <p class="bb-lead">И получите специальное предложение на клубную карту. Заполните форму – мы вам перезвоним.</p>
      <form class="bb-form x-form" method="post" action="#" novalidate>
        <input type="text" name="Name" placeholder="Ваше имя" autocomplete="name" />
        <input type="tel" name="Phone" placeholder="Телефон" autocomplete="tel" />
        <input type="email" name="Email" placeholder="E-mail" autocomplete="email" />
        <label class="bb-consent"><input type="checkbox" name="consent" checked /><span>Я ознакомлен(-а) с <a href="/security" target="_blank">Политикой обработки персональных данных</a> и даю свое <a href="/privacy" target="_blank">согласие</a> на обработку персональных данных.</span></label>
        <button class="bb-btn" type="submit">Оставить заявку</button>
      </form>
    </div>
  </section>

  <section class="x-sec x-split x-split--map" id="contacts">
    <div class="x-panel" data-rv>
      <Fragment set:html={rule(6)} />
      <h2 class="x-h2">Контакты</h2>
      <p class="bb-lead">{c.name}. Свяжитесь с нами удобным способом: звоните, пишите, приезжайте</p>
      <div class="x-contact">
        <a class="x-contact__phone" href={c.contacts.phone.href}>{c.contacts.phone.text}</a>
        <a href={c.contacts.email.href}>{c.contacts.email.text}</a>
      </div>
      <dl class="x-hours">
        {c.contacts.hours.map(([d, t]) => <div><dt>{d}</dt><dd>{t}</dd></div>)}
        <div><dt>Адрес</dt><dd>{c.contacts.address}</dd></div>
      </dl>
    </div>
    <div class="bb-m bb-map x-split__media" data-rv="up"><ClubMap club="imperial" /></div>
  </section>
  <BrandFooter slot="footer" club="imperial" />
</Site>

<script>
  import '../scripts/imperial3';
</script>
