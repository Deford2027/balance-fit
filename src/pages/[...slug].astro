---
/** Все страницы balance-fit.ru, перенесённые с Тильды (scripts/tilda-port.mjs):
    разметка и скрипты страницы как есть, ресурсы – локально в /_t/.
    Редиректы Тильды – meta refresh. Подпапка Pages (BASE_URL) дописывается
    здесь ко всем корневым путям: ссылкам страниц и ресурсам /_t/, в том
    числе внутри строк скриптов и экранированного JSON. */
type Page = {
  path: string;
  redirect?: string;
  htmlAttrs?: Record<string, string>;
  head?: string;
  bodyAttrs?: Record<string, string>;
  body?: string;
};

/** Своя палитра страницы (src/data/palettes/<путь>.json): замена цветов в разметке
    и стилях после порта и доп. CSS. Данные порта не трогаем – перепорт её не сотрёт. */
type Palette = { colors?: Record<string, string>; css?: string };

import ContentPage from '../components/pages/ContentPage.astro';
import { newPath, clubOf, shared, clubIds, fixLinks, type ClubId } from '../lib/routes';
import type { Content } from '../lib/blocks';

export function getStaticPaths() {
  const files = import.meta.glob<Page>('../data/pages/*.json', { eager: true, import: 'default' });
  const palettes = import.meta.glob<Palette>('../data/palettes/*.json', { eager: true, import: 'default' });
  /* Страницы, свёрстанные заново (файлы .astro в src/pages), идут в новом дизайне, а их версия
     Тильды – рядом для сравнения: /old/<путь>. Адреса – внутри клуба (lib/routes.ts). */
  const own = new Set(
    Object.keys(import.meta.glob('./**/*.astro'))
      .map((f) => f.replace(/^\.\//, '').replace(/\.astro$/, '').replace(/(^|\/)index$/, ''))
      .filter((p) => !p.includes('['))
  );
  /* Остальные страницы собраны общим шаблоном из выгрузки Тильды (src/data/content) */
  const contents = import.meta.glob<Content>('../data/content/*.json', { eager: true, import: 'default' });
  const content = new Map(Object.values(contents).map((c) => [c.path, c]));
  return Object.values(files).flatMap((page) => {
    /* Редиректы Тильды не нужны: ссылки сразу ведут на страницу клуба (lib/routes.ts) */
    if (page.redirect) return [];
    const props = { page, palette: palettes[`../data/palettes/${page.path || 'index'}.json`] };
    const to = newPath(page.path);
    const old = { params: { slug: `old/${page.path || 'index'}` }, props };
    const c = !own.has(to) ? content.get(page.path) : undefined;
    if (c && shared.includes(page.path)) return [...clubIds.map((club) => ({ params: { slug: `${club}/${page.path}` }, props: { ...props, content: c, club } })), old];
    if (c) return [{ params: { slug: to }, props: { ...props, content: c } }, old];
    if (own.has(to)) return [old];
    return [{ params: { slug: to || undefined }, props }];
  });
}

const { page, palette, content, club } = Astro.props as { page: Page; palette?: Palette; content?: Content; club?: ClubId };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function rebase(s: string) {
  if (!base) return s;
  /* сначала ссылки страниц (кроме /_t/), потом ресурсы – иначе префикс встанет дважды */
  return s
    .replace(/(\shref=)(["'])\/(?!\/|_t\/)/g, `$1$2${base}/`)
    .replace(/(^|[^\w/.\\-])\/_t\//g, `$1${base}/_t/`)
    .replace(/\\\/_t\\\//g, `${base.replace(/\//g, '\\/')}\\/_t\\/`);
}

function recolor(s: string) {
  if (!palette?.colors) return s;
  const map = Object.fromEntries(Object.entries(palette.colors).map(([k, v]) => [k.toLowerCase(), v]));
  const re = new RegExp(`(${Object.keys(map).join('|')})(?![0-9a-f])`, 'gi');
  return s.replace(re, (m) => map[m.toLowerCase()]);
}

const target = page.redirect?.startsWith('/') ? base + page.redirect : page.redirect;
---

{content ? <ContentPage content={content} club={club} /> : (
  page.redirect ? (
    <html lang="ru">
      <head>
        <meta charset="utf-8" />
        <meta name="robots" content="noindex, nofollow" />
        <meta http-equiv="refresh" content={`0; url=${target}`} />
        <title>Переадресация</title>
      </head>
      <body>
        <a href={target}>Перейти</a>
      </body>
    </html>
  ) : (
    <html {...page.htmlAttrs}>
      <head>
        <meta name="robots" content="noindex, nofollow" />
        <script is:inline src={`${base}/no-leads.js`}></script>
        <Fragment set:html={recolor(rebase(page.head!))} />
        {palette?.css && <style is:inline set:html={palette.css} />}
      </head>
      <body {...page.bodyAttrs}>
        <Fragment set:html={recolor(rebase(fixLinks(page.body!, clubOf(page.path))))} />
      </body>
    </html>
  )
)}
