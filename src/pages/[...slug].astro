---
/** Все страницы balance-fit.ru, перенесённые с Тильды (scripts/tilda-port.mjs):
    разметка и скрипты страницы как есть, ресурсы – локально в /_t/.
    Редиректы Тильды – meta refresh. Подпапка Pages (BASE_URL) дописывается
    здесь ко всем корневым путям: ссылкам страниц и ресурсам /_t/, в том
    числе внутри строк скриптов и экранированного JSON. */
type Page = {
  path: string;
  redirect?: string;
  htmlAttrs?: Record<string, string>;
  head?: string;
  bodyAttrs?: Record<string, string>;
  body?: string;
};

/** Своя палитра страницы (src/data/palettes/<путь>.json): замена цветов в разметке
    и стилях после порта и доп. CSS. Данные порта не трогаем – перепорт её не сотрёт. */
type Palette = { colors?: Record<string, string>; css?: string };

export function getStaticPaths() {
  const files = import.meta.glob<Page>('../data/pages/*.json', { eager: true, import: 'default' });
  const palettes = import.meta.glob<Palette>('../data/palettes/*.json', { eager: true, import: 'default' });
  return Object.values(files).map((page) => ({
    /* /admiral свёрстана заново (src/pages/admiral.astro, прошлая – admiral-v1.astro), версия Тильды – рядом для сравнения */
    params: { slug: page.path === 'admiral' ? 'admiral-tilda' : page.path || undefined },
    props: { page, palette: palettes[`../data/palettes/${page.path || 'index'}.json`] },
  }));
}

const { page, palette } = Astro.props as { page: Page; palette?: Palette };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function rebase(s: string) {
  if (!base) return s;
  /* сначала ссылки страниц (кроме /_t/), потом ресурсы – иначе префикс встанет дважды */
  return s
    .replace(/(\shref=)(["'])\/(?!\/|_t\/)/g, `$1$2${base}/`)
    .replace(/(^|[^\w/.\\-])\/_t\//g, `$1${base}/_t/`)
    .replace(/\\\/_t\\\//g, `${base.replace(/\//g, '\\/')}\\/_t\\/`);
}

function recolor(s: string) {
  if (!palette?.colors) return s;
  const map = Object.fromEntries(Object.entries(palette.colors).map(([k, v]) => [k.toLowerCase(), v]));
  const re = new RegExp(`(${Object.keys(map).join('|')})(?![0-9a-f])`, 'gi');
  return s.replace(re, (m) => map[m.toLowerCase()]);
}

const target = page.redirect?.startsWith('/') ? base + page.redirect : page.redirect;
---

{
  page.redirect ? (
    <html lang="ru">
      <head>
        <meta charset="utf-8" />
        <meta name="robots" content="noindex, nofollow" />
        <meta http-equiv="refresh" content={`0; url=${target}`} />
        <title>Переадресация</title>
      </head>
      <body>
        <a href={target}>Перейти</a>
      </body>
    </html>
  ) : (
    <html {...page.htmlAttrs}>
      <head>
        <meta name="robots" content="noindex, nofollow" />
        <script is:inline src={`${base}/no-leads.js`}></script>
        <Fragment set:html={recolor(rebase(page.head!))} />
        {palette?.css && <style is:inline set:html={palette.css} />}
      </head>
      <body {...page.bodyAttrs}>
        <Fragment set:html={recolor(rebase(page.body!))} />
      </body>
    </html>
  )
}
