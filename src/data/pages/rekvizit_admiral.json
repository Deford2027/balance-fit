 src=\"/_t/static/js/tilda-forms-1.0.min.js\" charset=\"utf-8\" async onerror=\"this.loaderr='y';\"></script> <script src=\"/_t/static/js/tilda-menu-1.0.min.js\" charset=\"utf-8\" async onerror=\"this.loaderr='y';\"></script> <script src=\"/_t/static/js/tilda-menu-widgeticons-1.0.min.js\" charset=\"utf-8\" async onerror=\"this.loaderr='y';\"></script> <script src=\"/_t/static/js/tilda-submenublocks-1.0.min.js\" charset=\"utf-8\" async onerror=\"this.loaderr='y';\"></script> <script src=\"/_t/static/js/tilda-zero-scale-1.0.min.js\" charset=\"utf-8\" async onerror=\"this.loaderr='y';\"></script> <script src=\"/_t/static/js/tilda-skiplink-1.0.min.js\" charset=\"utf-8\" async onerror=\"this.loaderr='y';\"></script> <script src=\"/_t/static/js/tilda-events-1.0.min.js\" charset=\"utf-8\" async onerror=\"this.loaderr='y';\"></script> <!-- nominify begin --><!-- calltouch -->  <!-- calltouch --> <!-- calltouch --> <script src=\"https://api-maps.yandex.ru/2.1/?lang=ru_RU&amp;apikey=831f87db-63c2-40d7-9323-264278280192\" type=\"text/javascript\" id=\"myYaMap\"></script> <!--   --> <!-- calltouch --> <!-- calltouch callback--> <!-- --> <!-- calltouch callback--> <!-- calltouch requsest -->  <!-- calltouch requsest --> <meta name=\"yandex-verification\" content=\"47137798536dfef6\" /> <!-- SEO-завод: поведение статей блога (оглавление, вопросы). Не редактировать руками --> <script>\n/* Живое оглавление статьи в Потоках Тильды: подсветка текущего раздела и полоса\n * прочитанного.\n *\n * 🔴 Внутрь поста скрипт положить нельзя — санитайзер Потоков вырезает <script>\n * из тела так же, как <img>. Зато код проекта он не трогает, поэтому файл целиком\n * кладётся ОДИН РАЗ в «Настройки сайта → Вставка кода».\n *\n * Без него страница остаётся читаемой: вопросы-ответы раскрыты всегда и от скрипта\n * не зависят, полосы прочитанного просто нет (см. _NO_JS_FIX в pagebuilder.py).\n * Класс `has-js` ставит этот файл — по нему тема показывает полосу.\n *\n * 🔴 Гонка, из-за которой оглавление оживало через раз: на странице ДВА блока\n * `.bal-page` — пустая обёртка ленты и сам пост. Обёртка есть в разметке сразу,\n * пост Тильда иногда подставляет позже. Прошлая версия на первом же проходе видела\n * обёртку, считала работу сделанной и больше не возвращалась — у поста оставались\n * серое оглавление без подсветки и без полосы. Поэтому теперь: успехом считается\n * только найденное оглавление, а до тех пор следим за изменениями DOM.\n */\n(function () {\n  \"use strict\";\n\n  var bound = false;\n\n  function markPages() {\n    var pages = document.querySelectorAll(\".bal-page\");\n    for (var i = 0; i < pages.length; i++) pages[i].classList.add(\"has-js\");\n    return pages.length;\n  }\n\n  /* Оглавление: подсветка текущего раздела и полоса прочитанного.\n     Возвращает true, только если действительно нашли, к чему привязаться. */\n  function contents() {\n    var links = [].slice.call(document.querySelectorAll(\".bal-page .side__nav a\"));\n    var bar = document.querySelector(\".bal-page .side__bar span\");\n    if (!links.length || !bar) return false;\n\n    var byId = {};\n    links.forEach(function (a) {\n      byId[(a.getAttribute(\"href\") || \"\").replace(/^#/, \"\")] = a;\n    });\n    var secs = [].slice.call(document.querySelectorAll(\".bal-page .sec[data-a]\"))\n      .filter(function (s) { return byId[s.getAttribute(\"data-a\")]; });\n    if (!secs.length) return false;\n    var art = document.querySelector(\".bal-page .article\");\n    var nav = document.querySelector(\".bal-page .side__nav\");\n\n    // Границы разделов считаем один раз и пересчитываем только при изменении размеров:\n    // в обработчике прокрутки остаётся чистая арифметика, без обращений к вёрстке.\n    var tops = [], artTop = 0, artHeight = 1;\n    function measure() {\n      var page = window.pageYOffset || document.documentElement.scrollTop;\n      tops = secs.map(function (s) { return s.getBoundingClientRect().top + page; });\n      if (art) {\n        var b = art.getBoundingClientRect();\n        artTop = b.top + page;\n        artHeight = b.height || 1;\n      }\n      update();\n    }\n\n    // 🔴 Пока человек листает оглавление сам, не перематываем список к активному\n    // пункту: иначе список «отпрыгивает» обратно на каждый шаг страницы, и это\n    // читается как «меню не листается».\n    var handScroll = 0, navAuto = false;\n    if (nav) {\n      nav.addEventListener(\"scroll\", function () {\n        if (!navAuto) handScroll = Date.now();\n        navAuto = false;\n      }, { passive: true });\n      nav.addEventListener(\"wheel\", function () { handScroll = Date.now(); }, { passive: true });\n      nav.addEventListener(\"touchstart\", function () { handScroll = Date.now(); }, { passive: true });\n      nav.addEventListener(\"pointerdown\", function () { handScroll = Date.now(); }, { passive: true });\n    }\n\n    // Длинное оглавление прокручивается внутри карточки: подсвеченный пункт\n    // подтягиваем в видимую часть, но двигаем только сам список.\n    function keepVisible(a) {\n      if (!nav || nav.scrollHeight <= nav.clientHeight + 4) return;\n      if (Date.now() - handScroll < 5000) return;      // человек листает сам\n      navAuto = true;\n      var top = a.offsetTop - nav.offsetTop;\n      var bottom = top + a.offsetHeight;\n      if (top < nav.scrollTop) nav.scrollTop = top - 8;\n      else if (bottom > nav.scrollTop + nav.clientHeight) {\n        nav.scrollTop = bottom - nav.clientHeight + 8;\n      }\n    }\n\n    var current = null;\n    function update() {\n      var page = window.pageYOffset || document.documentElement.scrollTop;\n      // Раздел считается текущим, когда его заголовок поднялся выше трети экрана.\n      var line = page + window.innerHeight * 0.35;\n      var idx = -1;\n      for (var i = 0; i < tops.length; i++) if (tops[i] <= line) idx = i;\n      // Ниже последнего раздела (вопросы-ответы, подвал) подсветку не гасим:\n      // человек всё ещё внутри статьи, и пустое оглавление читается как поломка.\n      if (idx < 0) idx = 0;\n      var active = byId[secs[idx].getAttribute(\"data-a\")];\n      if (active && active !== current) {\n        links.forEach(function (a) { a.classList.toggle(\"is-active\", a === active); });\n        current = active;\n        keepVisible(active);\n      }\n      var share = (page + window.innerHeight / 2 - artTop) / artHeight;\n      bar.style.width = (Math.max(0, Math.min(1, share)) * 100).toFixed(1) + \"%\";\n    }\n\n    // Троттлинг по времени, а не через requestAnimationFrame: rAF замирает в фоновой\n    // вкладке, и полоса с подсветкой «залипают» на том месте, где их застали.\n    var last = 0, timer = null;\n    function onScroll() {\n      var now = Date.now();\n      if (now - last >= 100) { last = now; update(); return; }\n      if (!timer) timer = setTimeout(function () { timer = null; last = Date.now(); update(); }, 100);\n    }\n    window.addEventListener(\"scroll\", onScroll, { passive: true });\n    window.addEventListener(\"resize\", measure, { passive: true });\n    window.addEventListener(\"load\", measure);\n    // Картинки догружаются и сдвигают разделы — границы надо пересчитать.\n    setTimeout(measure, 1200);\n    setTimeout(measure, 4000);\n    measure();\n    return true;\n  }\n\n  function tryBind() {\n    markPages();\n    if (bound) return true;\n    bound = contents();\n    return bound;\n  }\n\n  function start() {\n    if (tryBind()) return;\n    // Пост может приехать позже разметки страницы: следим за DOM, пока не появится.\n    if (window.MutationObserver) {\n      var mo = new MutationObserver(function () { if (tryBind()) mo.disconnect(); });\n      mo.observe(document.documentElement, { childList: true, subtree: true });\n      setTimeout(function () { mo.disconnect(); }, 20000);\n    }\n    var tries = 0;\n    var t = setInterval(function () {\n      if (tryBind() || ++tries > 40) clearInterval(t);\n    }, 500);\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", start);\n  } else {\n    start();\n  }\n})();\n</script> <meta name=\"p:domain_verify\" content=\"852854f3e15f45a8b92283e1573f3948\"/> <!-- nominify end --> <!-- Global Site Tag (gtag.js) - Google Analytics -->  <!-- VK Pixel Code -->  <!-- End VK Pixel Code --> <script type=\"text/javascript\">(function() {var ttt='cebo';var tt='oog';var re=new RegExp(\"bot|g\" + tt + \"le|yandex|baidu|bing|msn|duckduckbot|teoma|slurp|crawler|spider|robot|crawling|fa\" + ttt + \"ok\",\"i\");if((re.test(navigator.userAgent))===false&&typeof(sessionStorage)!='undefined'&&sessionStorage.getItem('visited')!=='y'&&document.visibilityState){var style=document.createElement('style');style.type='text/css';style.innerHTML='@media screen and (min-width: 980px) {.t-records {opacity: 0;}.t-records_animated {-webkit-transition: opacity ease-in-out .2s;-moz-transition: opacity ease-in-out .2s;-o-transition: opacity ease-in-out .2s;transition: opacity ease-in-out .2s;}.t-records.t-records_visible {opacity: 1;}}';document.getElementsByTagName('head')[0].appendChild(style);function t_setvisRecs(){var alr=document.querySelectorAll('.t-records');Array.prototype.forEach.call(alr,function(el) {el.classList.add(\"t-records_animated\");});setTimeout(function() {Array.prototype.forEach.call(alr,function(el) {el.classList.add(\"t-records_visible\");});sessionStorage.setItem(\"visited\",\"y\");},400);}\ndocument.addEventListener('DOMContentLoaded',t_setvisRecs);}})();</script>","bodyAttrs":{"class":"t-body","style":"margin:0;"},"body":"<!--allrecords--> <div id=\"allrecords\" class=\"t-records\" data-hook=\"blocks-collection-content-node\" data-tilda-project-id=\"4906566\" data-tilda-page-id=\"47075173\" data-tilda-page-alias=\"rekvizit_admiral\" data-tilda-formskey=\"06dd6f98b3a276ad760dd0fda4906566\" data-tilda-lazy=\"yes\" data-tilda-root-zone=\"com\" data-tilda-project-headcode=\"yes\" data-tilda-ts=\"y\" data-tilda-project-country=\"RU\"> <div id=\"rec7335