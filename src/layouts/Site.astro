---
/** Каркас страниц нового дизайна: шапка клуба, меню, подвал и попапы.
    Пути в разметке страниц корневые (/imperial, /_t/...): подпапка Pages дописывается здесь.
    Попапы (#popup:..., #submenu:...) собираются по ссылкам на странице – см. Popups.astro. */
import '../styles/site.css';
import Popups from '../components/Popups.astro';
import { clubs, clubList, icons, type ClubId, type Link } from '../data/clubs';
import { rebase } from '../lib/rebase';

type Props = {
  title: string;
  description?: string;
  club?: ClubId; // без клуба – страница сети (выбор клуба)
  path: string; // путь страницы без слэша – для попапов со своим текстом
  crumbs?: Link[];
};

const { title, description, club: clubId, path, crumbs } = Astro.props;
const club = clubId ? clubs[clubId] : undefined;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const body = await Astro.slots.render('default');
const ext = (href: string) => /^https?:/.test(href);
const linkAttrs = (href: string) => (ext(href) ? { target: '_blank', rel: 'noopener' } : {});
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={`${base}${icons.favicon}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline src={`${base}/no-leads.js`}></script>
  </head>
  <body>
    <div class="bla" id="bla">
      <header class="bla-head">
        <div class="bla-wrap">
          <div class="bla-head__in">
            <a class="bla-logo" href={`${base}/`}><img src={`${base}${icons.logo}`} alt="Balance" /></a>
            <nav class="bla-nav">
              <div class="bla-pick" data-pick>
                <button type="button" aria-haspopup="true">{club ? club.short : 'Выбор клуба'}</button>
                <div class="bla-pick__list">
                  {clubList.map((c) => (
                    <a href={`${base}${c.home}`} class={c.id === clubId ? 'is-active' : undefined}>{c.name}<small>{c.city}</small></a>
                  ))}
                  <a href={`${base}/`}>Все клубы<small>Выбор клуба</small></a>
                </div>
              </div>
              {club && <a href={club.headerPhone.href}>{club.short}: {club.headerPhone.text}</a>}
              {club && <a href={club.callback}>Заказать звонок</a>}
            </nav>
            <div class="bla-head__act">
              {club?.lk && <a class="bla-lk" href={`${base}${club.lk.href}`} title="Личный кабинет">{club.lk.text}</a>}
              <a class="bla-btn bla-btn--green" href="#popup:infoblock">Программа лояльности</a>
              <button class="bla-burger" type="button" aria-label="Меню" data-burger><span></span><span></span><span></span></button>
            </div>
          </div>
          <div class="bla-drawer">
            <div class="bla-drawer__grid">
              {club ? (
                <>
                  <a href={`${base}/`} class="bla-drawer__extra">Выбор клуба</a>
                  <a href={club.headerPhone.href} class="bla-drawer__extra">{club.headerPhone.text}</a>
                  <a href={club.callback} class="bla-drawer__extra">Заказать звонок</a>
                  <a href="#popup:infoblock" class="bla-drawer__extra">Программа лояльности</a>
                  {club.menu.map((l) => <a href={ext(l.href) ? l.href : `${base}${l.href}`} {...linkAttrs(l.href)}>{l.text}</a>)}
                  {club.subscription && <a href={`${base}${club.subscription.href}`}>{club.subscription.text}</a>}
                </>
              ) : (
                <>
                  {clubList.map((c) => <a href={`${base}${c.home}`}>{c.name}</a>)}
                  <a href="#popup:infoblock">Программа лояльности</a>
                  <a href={`${base}/loyalty`}>Положение о программе лояльности</a>
                </>
              )}
            </div>
            {club && (
              <div class="bla-drawer__foot">
                <span>{club.contacts.address}</span>
                <div class="bla-soc">
                  <a href={club.social.vk} target="_blank" rel="noopener"><img src={`${base}${icons.vk}`} alt="VK" /></a>
                  <a href={club.social.max} target="_blank" rel="noopener"><img src={`${base}${icons.max}`} alt="MAX" /></a>
                  <a href={club.social.tg} target="_blank" rel="noopener"><img src={`${base}${icons.tg}`} alt="Telegram" /></a>
                  <a href={club.social.wa} target="_blank" rel="noopener"><img src={`${base}${icons.wa}`} alt="WhatsApp" /></a>
                </div>
              </div>
            )}
          </div>
        </div>
      </header>

      <main>
        {crumbs && (
          <div class="bla-wrap">
            <nav class="bla-crumbs" aria-label="Навигация">
              {crumbs.map((c, i) => (i < crumbs.length - 1 ? <a href={`${base}${c.href}`}>{c.text}</a> : <span>{c.text}</span>))}
            </nav>
          </div>
        )}
        <Fragment set:html={rebase(body, base)} />
      </main>

      <footer class="bla-wrap">
        {club ? (
          <div class="bla-foot">
            <a class="bla-foot__logo" href={`${base}/`}><img src={`${base}${icons.logo}`} alt="Balance" /></a>
            <nav class="bla-foot__col">
              {club.footerNav.map((l) => <a href={ext(l.href) ? l.href : `${base}${l.href}`} {...linkAttrs(l.href)}>{l.text}</a>)}
            </nav>
            <div class="bla-soc">
              <a href={club.social.vk} target="_blank" rel="noopener"><img src={`${base}${icons.vk}`} alt="VK" /></a>
              <a href={club.social.max} target="_blank" rel="noopener"><img src={`${base}${icons.max}`} alt="MAX" /></a>
              <a href={club.social.tg} target="_blank" rel="noopener"><img src={`${base}${icons.tg}`} alt="Telegram" /></a>
              <a href={club.social.wa} target="_blank" rel="noopener"><img src={`${base}${icons.wa}`} alt="WhatsApp" /></a>
            </div>
            <nav class="bla-foot__col">
              {club.footerDocs.map((l) => <a href={ext(l.href) ? l.href : `${base}${l.href}`} {...linkAttrs(l.href)}>{l.text}</a>)}
            </nav>
          </div>
        ) : (
          <div class="bla-foot">
            <a class="bla-foot__logo" href={`${base}/`}><img src={`${base}${icons.logo}`} alt="Balance" /></a>
            <nav class="bla-foot__col">
              {clubList.map((c) => <a href={`${base}${c.home}`}>{c.name}</a>)}
            </nav>
            <nav class="bla-foot__col">
              {clubList.map((c) => <a href={c.headerPhone.href}>{c.short}: {c.headerPhone.text}</a>)}
            </nav>
            <nav class="bla-foot__col">
              <a href={`${base}/loyalty`}>Положение о программе лояльности</a>
              <a href={`${base}/metrika`}>Согласие на использование Яндекс.Метрики</a>
            </nav>
          </div>
        )}
      </footer>

      <Popups html={body} path={path} extra={['#popup:infoblock', ...(club ? [club.callback] : [])]} />
    </div>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
